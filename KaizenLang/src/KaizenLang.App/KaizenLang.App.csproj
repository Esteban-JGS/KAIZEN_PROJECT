<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Suppress WinForms platform compatibility warnings (CA1416) which are expected for this Windows-only UI project -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Prevent SDK from generating assembly attributes that duplicate manual/generated ones -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Prevent SDK from generating target framework attribute if it's already present -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationIcon>..\..\Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MainForm busca el ícono en <salida>\Resources\icon.ico -->
    <None Include="..\..\Resources\icon.ico" Link="Resources\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaizenLang.UI\KaizenLang.UI.csproj" />
  </ItemGroup>

</Project>
